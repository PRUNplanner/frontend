{
	// the engine package's own check is packages/engine/tsconfig.json; its
	// files are listed here because engineContext.test.ts imports its fixtures
	"include": [
		"src/**/*",
		"src/vite-env.d.ts",
		"src/**/*.json",
		"packages/engine/src/**/*",
		"packages/engine/tests/fixtures/**/*"
	],
	"exclude": ["dist/**/*", "coverage/**/*", ".vscode/**/*", ".github/**/*"],
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"composite": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
