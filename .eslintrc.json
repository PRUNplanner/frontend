{
	"root": true,
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"globals": {
		"__APP_VERSION__": "readonly",
		"__BUILD_ID__": "readonly"
	},
	"parser": "vue-eslint-parser",
	"parserOptions": {
		"parser": "@typescript-eslint/parser",
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"extends": [
		"eslint:recommended",
		"plugin:@typescript-eslint/recommended",
		"plugin:vue/vue3-recommended"
	],
	"ignorePatterns": [
		"dist/",
		"coverage/",
		"tsconfig.json",
		"tailwind.config.js",
		"dist-mcp/"
	],
	"rules": {
		"@typescript-eslint/no-explicit-any": "warn",
		"@typescript-eslint/no-unused-expressions": [
			"error",
			{ "allowTernary": true }
		],
		"no-async-promise-executor": "off",
		"no-mixed-spaces-and-tabs": "off",
		"@typescript-eslint/ban-types": "off",
		"no-unused-vars": "off",
		"@typescript-eslint/no-unused-vars": [
			"warn",
			{
				"varsIgnorePattern": "^_",
				"argsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"ignoreRestSiblings": true
			}
		],
		"@typescript-eslint/consistent-type-definitions": [
			"error",
			"interface"
		],
		"@typescript-eslint/no-import-type-side-effects": "error",
		"@typescript-eslint/consistent-type-imports": [
			"error",
			{
				"prefer": "type-imports",
				"fixStyle": "inline-type-imports",
				"disallowTypeAnnotations": false
			}
		],
		"vue/no-unused-vars": ["error", { "ignorePattern": "^_" }],
		"vue/max-attributes-per-line": "off",
		"vue/multiline-html-element-content-newline": "off",
		"vue/html-indent": "off",
		"vue/singleline-html-element-content-newline": "off",
		"vue/html-closing-bracket-newline": "off",
		"vue/html-self-closing": "off",
		"vue/no-unused-components": [
			"error",
			{ "ignoreWhenBindingPresent": true }
		],
		"vue/no-unused-properties": [
			"warn",
			{ "groups": ["props", "setup"], "deepData": false }
		]
	},
	"overrides": [
		{
			"files": [
				"src/features/api/schemas/**",
				"src/**/*.schemas.ts",
				"packages/engine/src/schemas/**"
			],
			"rules": {
				"no-restricted-syntax": [
					"error",
					{
						"selector": "TSTypeReference[typeName.name='ZodType'], TSTypeReference[typeName.right.name='ZodType']",
						"message": "Don't annotate schemas as z.ZodType<…>; derive the type with z.infer."
					}
				]
			}
		},
		{
			"files": ["src/tests/**", "packages/engine/tests/**"],
			"rules": {
				"@typescript-eslint/no-explicit-any": "off",
				"@typescript-eslint/ban-ts-comment": [
					"error",
					{ "ts-expect-error": false }
				]
			}
		},
		{
			"files": ["packages/engine/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^(?!\\.\\.?/|zod$)",
								"message": "The engine package only imports itself and zod."
							},
							{
								"regex": "^\\.\\./\\.\\./",
								"message": "The engine package only imports itself and zod."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/engine/tests/**", "packages/engine/scripts/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^(?!\\.\\.?/|zod$|vitest$|node:|@prunplanner/test-data(/|$))",
								"message": "Engine tests import the package, zod, vitest, node: and @prunplanner/test-data."
							},
							{
								"regex": "^\\.\\./\\.\\./(\\.\\./|(?!src/))",
								"message": "Engine tests import the package, zod, vitest, node: and @prunplanner/test-data."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/**"],
			"excludedFiles": ["src/tests/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@prunplanner/test-data",
									"@prunplanner/test-data/*"
								],
								"message": "@prunplanner/test-data is for tests only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/features/production_chain/engine/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "vue",
								"message": "The planning engine must not import Vue."
							},
							{
								"name": "pinia",
								"message": "The planning engine must not import Vue."
							}
						],
						"patterns": [
							{
								"group": ["@vue/*", "vue-*"],
								"message": "The planning engine must not import Vue."
							},
							{
								"group": [
									"@/stores/*",
									"!@/stores/*.types",
									"@/database/*"
								],
								"message": "The planning engine gets its data through IPlanContext."
							},
							{
								"group": [
									"@prunplanner/test-data",
									"@prunplanner/test-data/*"
								],
								"message": "@prunplanner/test-data is for tests only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/mcp/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "vue",
								"message": "The MCP server runs in Node without the app."
							},
							{
								"name": "pinia",
								"message": "The MCP server runs in Node without the app."
							},
							{
								"name": "vue-i18n",
								"message": "The MCP server runs in Node without the app."
							},
							{
								"name": "axios",
								"message": "The MCP server runs in Node without the app."
							}
						],
						"patterns": [
							{
								"group": [
									"@vue/*",
									"vue-*",
									"@/lib/*",
									"@/ui/*",
									"@/util/numbers",
									"**/*.vue"
								],
								"message": "The MCP server runs in Node without the app."
							},
							{
								"regex": "^@/(stores|database)/(?!.*\\.types$)",
								"message": "The MCP server runs in Node without the app."
							},
							{
								"group": [
									"@prunplanner/test-data",
									"@prunplanner/test-data/*"
								],
								"message": "@prunplanner/test-data is for tests only."
							}
						]
					}
				]
			}
		}
	]
}
