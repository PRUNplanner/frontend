{
	"name": "prunplanner_frontend",
	"private": true,
	"version": "0.34.1",
	"dbVersion": "26.10.17",
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr src/prerender.ts --outDir .prerender && node scripts/prerender.mjs",
		"tsc": "vue-tsc --project tsconfig.typecheck.json",
		"tsc:watch": "vue-tsc --project tsconfig.typecheck.json --watch",
		"preview": "vite preview",
		"test": "vitest --run --silent",
		"test:components": "vitest --run --config vitest.components.config.ts",
		"test:watch": "vitest watch",
		"test:ui": "vitest --ui",
		"test:coverage": "rm -rf .vitest/blob coverage && pnpm test:coverage:unit && pnpm test:coverage:components && pnpm test:coverage:report",
		"test:coverage:unit": "vitest run --silent --coverage --reporter=dot --reporter=blob --outputFile.blob=.vitest/blob/unit$BLOB_SUFFIX.json",
		"test:coverage:components": "vitest run --silent --coverage --config vitest.components.config.ts --reporter=dot --reporter=blob --outputFile.blob=.vitest/blob/components$BLOB_SUFFIX.json",
		"test:coverage:report": "vitest --merge-reports --silent --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"knip": "knip",
		"refresh:systems": "node scripts/refresh-systems.mjs"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.3.0",
		"@fontsource/roboto-mono": "^5.3.0",
		"@intlify/message-compiler": "^11.4.16",
		"@popperjs/core": "^2.11.8",
		"@tailwindcss/vite": "^4.3.3",
		"@unhead/vue": "^3.4.3",
		"@vue/devtools-api": "^8.2.1",
		"axios": "^1.20.0",
		"chart.js": "^4.6.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"dayjs": "^1.11.23",
		"fast-equals": "^6.2.1",
		"idb": "^8.0.4",
		"lightweight-charts": "^5.2.1",
		"lodash-es": "^4.18.1",
		"numbro": "^2.5.0",
		"p-limit": "^7.3.3",
		"papaparse": "^5.7.0",
		"pinia": "^4.1.0",
		"pinia-plugin-persistedstate": "^4.7.1",
		"posthog-js": "^1.438.21",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.44",
		"vue-chartjs": "^5.3.4",
		"vue-i18n": "^11.4.16",
		"vue-router": "^5.4.0",
		"vue-showdown": "^4.2.0",
		"yalps": "^0.6.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "26.6.5",
		"@types/papaparse": "^5.5.2",
		"@typescript-eslint/parser": "^8.72.0",
		"@vicons/material": "^0.13.0",
		"@vitejs/plugin-vue": "6.0.10",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"@vue/test-utils": "2.5.1",
		"axe-core": "^4.14.0",
		"axios-mock-adapter": "^2.1.0",
		"eslint": "^10.13.0",
		"eslint-plugin-vue": "^10.11.1",
		"fake-indexeddb": "^6.2.6",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"knip": "^5.88.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"unplugin-auto-import": "^21.1.0",
		"vite": "^8.3.5",
		"vite-plugin-compression2": "^2.5.3",
		"vitest": "^5.0.5",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "3.3.13"
	}
}
