{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"ignoreDeprecations": "5.0", // required until vue-tsc supports TS6
		"noEmit": true,
	},
	// unknown props and events on components fail the type check
	"vueCompilerOptions": {
		"checkUnknownProps": true,
		"checkUnknownEvents": true,
	},
}
